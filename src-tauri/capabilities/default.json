{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main and splash windows",
  "windows": ["main", "splashscreen"],
  "permissions": [
    "core:default",
    "allow-app-commands",
    "allow-fechar-splashscreen",
    "opener:default",
    "dialog:default",
    "notification:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-select",
    "sql:allow-execute",
    "sql:allow-close",
    "updater:default",
    "process:default"
  ]
}
