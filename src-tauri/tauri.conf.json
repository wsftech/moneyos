{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Money OS",
  "version": "0.1.0",
  "identifier": "com.financas.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Money OS",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "shortDescription": "Controle financeiro pessoal e empresarial",
    "longDescription": "Money OS — gestão de contas, transações, orçamentos, metas e relatórios financeiros.",
    "copyright": "Copyright © 2026",
    "category": "Finance",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:financas.db"]
    },
    "updater": {
      "pubkey": "SUBSTITUA_PELA_CHAVE_PUBLICA_APOS_SETUP",
      "endpoints": [
        "https://github.com/SEU_USUARIO/money-os/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
