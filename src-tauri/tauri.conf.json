{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WSF Money",
  "version": "0.1.19",
  "identifier": "com.financas.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WSF Money",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true
      },
      {
        "label": "splashscreen",
        "title": "WSF Money",
        "url": "splash.html",
        "width": 360,
        "height": 420,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "center": true,
        "visible": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "shortDescription": "Controle financeiro pessoal e empresarial",
    "longDescription": "WSF Money — gestão de contas, transações, orçamentos, metas e relatórios financeiros. Copyright © 2026 WSF tecnologia Ltda. CNPJ 54.492.026/0001-23.",
    "copyright": "Copyright © 2026 WSF tecnologia Ltda — CNPJ 54.492.026/0001-23",
    "publisher": "WSF tecnologia Ltda",
    "category": "Finance",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:financas.db"
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBQzQyRTZCQkIwRDc3MjIKUldRaWR3MjdheTdFT3ZXcDVaS1REYlFZSExNcXR5UXpOZU9ISXAyTTFybU8rTjVZV2Uwa3hiWmYK",
      "endpoints": [
        "https://github.com/wsftech/moneyos/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "basicUi",
        "installerArgs": [
          "/P"
        ]
      }
    }
  }
}
